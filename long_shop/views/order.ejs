<!DOCTYPE html>
<html>
<head>
    <title>Product Orders</title>
    <link rel="stylesheet" href="/style.css">
</head>

<body>

<div class="order-container">

    <h1>Product Orders</h1>

    <table>
        <thead>
            <tr>
                <th>Customer Name</th>
                <th>Product Name</th>
                <th>Quantity</th>
                <th>Order Date</th>
                <th>Total Price</th>
                <th>Action</th>
            </tr>
        </thead>

        <tbody>
            <% orders.forEach(order => { %>

            <tr>
                <td><%= order.customerName %></td>

                <td><%= order.productName %></td>

                <td><%= order.quantity %></td>

                <td>
                    <%= new Date(order.orderDate).toLocaleDateString("en-US") %>
                </td>

                <td>
                    <%= order.totalPrice.toLocaleString("en-US") %> VND
                </td>

                <td class="actions">

                    <a
                        href="/orders/update/<%= order._id %>"
                        class="update-btn">
                        Update
                    </a>

                    <form
                        action="/orders/delete/<%= order._id %>"
                        method="POST"
                        style="display:inline;">

                        <button
                            type="submit"
                            class="delete-btn"
                            onclick="return confirm('Delete this order?')">
                            Delete
                        </button>

                    </form>

                </td>
            </tr>

            <% }) %>
        </tbody>
    </table>

    <div class="create-container">
        <a href="/orders/create" class="create-btn">
            Create New Order
        </a>
    </div>

</div>

</body>
</html>